#:import dp kivy.metrics.dp

# ══════════════════════════════════════════════════════════════════════════════
# DESIGN SYSTEM: Color Palette & Typography Constants
# ══════════════════════════════════════════════════════════════════════════════
# Dark theme optimized for microscopy inspection and UV fluorescence imaging.

#:set COLOR_BG_PRIMARY (0.0588, 0.0588, 0.0588, 1)          # #0F0F0F - Near black
#:set COLOR_BG_SURFACE (0.1020, 0.1020, 0.1020, 1)          # #1A1A1A - Surface lift
#:set COLOR_BG_PANEL (0.1255, 0.1255, 0.1255, 1)            # #202020 - Panel bg

#:set COLOR_ACCENT_PRIMARY (0, 0.8863, 1, 1)                # #00E3FF - Cyan (primary)
#:set COLOR_ACCENT_SECONDARY (0.4627, 1, 0.0118, 1)         # #76FF00 - Lime-green
#:set COLOR_ACCENT_WARN (1, 0.2, 0.2, 1)                    # #FF3333 - Red alert

#:set COLOR_TEXT_PRIMARY (1, 1, 1, 1)                       # #FFFFFF - White
#:set COLOR_TEXT_SECONDARY (0.6902, 0.6902, 0.6902, 1)      # #B0B0B0 - Muted gray
#:set COLOR_TEXT_TERTIARY (0.4, 0.4, 0.4, 1)                # #666666 - Dark gray

#:set COLOR_BORDER_SUBTLE (0.2, 0.2, 0.2, 1)                # #333333 - Subtle dividers

# ──────────────────────────────────────────────────────────────────────────────
# Reusable Component Definitions
# ──────────────────────────────────────────────────────────────────────────────

<ThresholdSliderControl@MDBoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(48)
    spacing: dp(8)
    padding: dp(4)

    MDLabel:
        id: label
        text: "Threshold"
        role: "small"
        text_color: COLOR_TEXT_SECONDARY
        size_hint_x: 0.3

    MDSlider:
        id: slider
        min: 0.0
        max: 1.0
        value: 0.5
        size_hint_x: 0.5
        color: COLOR_ACCENT_PRIMARY
        on_value: numeric_input.text = f"{self.value:.2f}"

    MDTextField:
        id: numeric_input
        text: "0.50"
        mode: "rectangle"
        size_hint_x: 0.2
        height: dp(36)
        input_filter: "float"
        multiline: False

<ParticleCountBadge@MDCard>:
    orientation: "vertical"
    size_hint: None, None
    size: dp(140), dp(100)
    padding: dp(12)
    spacing: dp(8)
    elevation: 2
    md_bg_color: COLOR_BG_SURFACE
    radius: [dp(8)]

    MDLabel:
        id: value_label
        text: "0"
        font_style: "Display"
        theme_text_color: "Custom"
        text_color: COLOR_ACCENT_PRIMARY
        bold: True
        halign: "center"
        size_hint_y: 0.6

    MDLabel:
        id: title_label
        text: "Total"
        role: "small"
        theme_text_color: "Custom"
        text_color: COLOR_TEXT_SECONDARY
        halign: "center"
        size_hint_y: 0.4

<MetricItem@MDBoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(24)
    spacing: dp(8)

    MDLabel:
        id: metric_label
        text: "Metric"
        role: "small"
        text_color: COLOR_TEXT_SECONDARY
        size_hint_x: 0.6

    MDLabel:
        id: metric_value
        text: "0.00"
        role: "small"
        font_name: "RobotoMono"
        text_color: COLOR_TEXT_PRIMARY
        halign: "right"
        size_hint_x: 0.4

<OverlayToggleButton@MDBoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(32)
    spacing: dp(8)
    padding: dp(4, 0)

    MDCheckbox:
        id: toggle
        active: True
        size_hint_x: 0.1

    MDLabel:
        id: toggle_label
        text: "Show Overlay"
        role: "small"
        text_color: COLOR_TEXT_PRIMARY
        size_hint_x: 0.9

<ProgressIndicator@MDBoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(60)
    padding: dp(8)
    spacing: dp(4)
    md_bg_color: (0, 0, 0, 0.5)
    radius: [dp(6)]

    MDLabel:
        id: progress_text
        text: "Processing..."
        role: "small"
        text_color: COLOR_ACCENT_PRIMARY
        halign: "center"

    MDProgressBar:
        id: progress_bar
        value: 0
        max: 100
        height: dp(3)

# ══════════════════════════════════════════════════════════════════════════════
# Screen Definitions
# ══════════════════════════════════════════════════════════════════════════════

<MDScreenManager>:
    md_bg_color: COLOR_BG_PRIMARY

# ── InferenceScreen ───────────────────────────────────────────────
<InferenceScreen>:
    MDFloatLayout:
        md_bg_color: COLOR_BG_PRIMARY

        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, 1

            MDTopAppBar:
                id: inf_toolbar
                MDTopAppBarTitle:
                    text: "Inference"

            BoxLayout:
                size_hint: 1, 0.55
                md_bg_color: 0, 0, 0, 0.2

                BoxLayout:
                    id: raw_container
                    size_hint: 0.5, 1
                    Image:
                        id: raw_image

                BoxLayout:
                    id: ann_container
                    size_hint: 0.5, 1
                    Image:
                        id: ann_image

            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "48dp"
                padding: "16dp", 0
                spacing: "12dp"

                MDLabel:
                    text: "RAW"
                    halign: "center"
                    font_style: "Label"
                    size_hint_x: 0.25
                    theme_text_color: "Custom"
                    text_color: COLOR_ACCENT_PRIMARY

                MDSlider:
                    id: split_slider
                    min: 0
                    max: 1
                    value: 0.5
                    on_value: root.update_split(self.value)
                    color: 0, 0.898, 1, 1

                MDLabel:
                    text: "ANN"
                    halign: "center"
                    font_style: "Label"
                    size_hint_x: 0.25
                    theme_text_color: "Custom"
                    text_color: COLOR_ACCENT_SECONDARY
                            halign: "left"

                        MDLabel:
                            id: avg_label
                            text: "Avg Conf: 0.00"
                            font_style: "Title"
                            halign: "right"
                            theme_text_color: "Secondary"

                    MDDivider:

                    GridLayout:
                        cols: 3
                        size_hint_y: None
                        height: "20dp"
                        spacing: "0dp"
                        MDLabel:
                            text: "Type"
                            bold: True
                            size_hint_x: 0.4
                            font_style: "Label"
                        MDLabel:
                            text: "Count"
                            bold: True
                            halign: "center"
                            size_hint_x: 0.3
                            font_style: "Label"
                        MDLabel:
                            text: "Avg Conf"
                            bold: True
                            halign: "center"
                            size_hint_x: 0.3
                            font_style: "Label"

                    GridLayout:
                        cols: 3
                        size_hint_y: None
                        height: "132dp"
                        spacing: "0dp"
                        MDLabel:
                            text: "PET"
                            font_style: "Body"
                            size_hint_x: 0.4
                        MDLabel:
                            id: pet_count
                            text: "0"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            id: pet_conf
                            text: "0.00"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            text: "HDPE"
                            font_style: "Body"
                            size_hint_x: 0.4
                        MDLabel:
                            id: hdpe_count
                            text: "0"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            id: hdpe_conf
                            text: "0.00"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            text: "PVC"
                            font_style: "Body"
                            size_hint_x: 0.4
                        MDLabel:
                            id: pvc_count
                            text: "0"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            id: pvc_conf
                            text: "0.00"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            text: "LDPE"
                            font_style: "Body"
                            size_hint_x: 0.4
                        MDLabel:
                            id: ldpe_count
                            text: "0"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            id: ldpe_conf
                            text: "0.00"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            text: "PP"
                            font_style: "Body"
                            size_hint_x: 0.4
                        MDLabel:
                            id: pp_count
                            text: "0"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            id: pp_conf
                            text: "0.00"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            text: "PS"
                            font_style: "Body"
                            size_hint_x: 0.4
                        MDLabel:
                            id: ps_count
                            text: "0"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3
                        MDLabel:
                            id: ps_conf
                            text: "0.00"
                            halign: "center"
                            font_style: "Body"
                            size_hint_x: 0.3

        # ── Floating HUD ──────────────────────────────────────────
        MDCard:
            id: hud_panel
            size_hint: None, None
            size: "200dp", "90dp"
            pos_hint: {"right": 0.98, "top": 0.94}
            md_bg_color: COLOR_BG_SURFACE
            padding: "10dp"
            spacing: "4dp"
            elevation: 4

            MDBoxLayout:
                orientation: "vertical"
                spacing: "2dp"

                MDLabel:
                    id: hud_backend
                    text: "[ONNX - CPU]"
                    font_style: "Label"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: COLOR_ACCENT_PRIMARY
                    size_hint_y: None
                    height: "18dp"

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "8dp"
                    size_hint_y: None
                    height: "18dp"

                    MDLabel:
                        id: hud_fps
                        text: "FPS: 0"
                        font_style: "Label"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        size_hint_x: 0.5

                    MDLabel:
                        id: hud_latency
                        text: "Latency: 0ms"
                        font_style: "Label"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        size_hint_x: 0.5

        # ── Camera control bar ────────────────────────────────────
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "56dp"
            padding: "20dp"
            spacing: "32dp"
            pos_hint: {"center_x": 0.5, "y": 0}
            md_bg_color: COLOR_BG_PANEL

            MDIconButton:
                icon: "camera"
                theme_text_color: "Custom"
                text_color: COLOR_ACCENT_PRIMARY
                pos_hint: {"center_y": 0.5}
                on_release: app.inference_take_snapshot()

            MDLabel:
                id: inf_timer
                text: ""
                halign: "center"
                theme_text_color: "Custom"
                text_color: 0.4627, 1, 0.0118, 1
                font_style: "Title"
                size_hint_x: None
                width: "60dp"

            MDIconButton:
                id: inf_record_btn
                icon: "record-circle-outline"
                theme_text_color: "Custom"
                text_color: 1, 0.2, 0.2, 1
                pos_hint: {"center_y": 0.5}
                on_release: app.inference_toggle_recording()

# ── ModelManagerScreen ────────────────────────────────────────────
<ModelManagerScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: COLOR_BG_PRIMARY

        MDTopAppBar:
            MDTopAppBarTitle:
                text: "Model Manager"
            MDTopAppBarTrailingButtonContainer:
                MDIconButton:
                    icon: "plus"
                    on_release: app.mm_add_model_dialog()

        ScrollView:
            MDBoxLayout:
                id: mm_model_list
                orientation: "vertical"
                padding: "12dp"
                spacing: "10dp"
                size_hint_y: None
                height: self.minimum_height

# ── UploadGatewayScreen ───────────────────────────────────────────
<UploadGatewayScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: COLOR_BG_PRIMARY

        MDTopAppBar:
            id: ug_toolbar
            MDTopAppBarTitle:
                text: "Upload & Detect"

        MDRelativeLayout:
            size_hint_y: 0.40
            md_bg_color: 0, 0, 0, 0.2

            Image:
                id: ug_image
                source: ""
                size_hint: 1, 1
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                opacity: 1 if app.ug_has_image else 0

            MDBoxLayout:
                orientation: "vertical"
                spacing: "12dp"
                size_hint: None, None
                size: "250dp", "120dp"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                opacity: 0 if app.ug_has_image else 1
                disabled: app.ug_has_image

                MDIcon:
                    icon: "image-search-outline"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 0.5
                    font_size: "64sp"
                    halign: "center"
                    pos_hint: {"center_x": 0.5}

                MDLabel:
                    text: "No Image/Video Selected"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 0.5
                    halign: "center"
                    font_style: "Title"

            MDLabel:
                text: "Processing..."
                halign: "center"
                theme_text_color: "Custom"
                text_color: 0, 0.898, 1, 1
                font_style: "Title"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                opacity: 1 if app.ug_processing else 0

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "60dp"
            padding: "16dp"
            spacing: "16dp"

            MDButton:
                pos_hint: {"center_y": 0.5}
                size_hint_x: 1.0
                height: "44dp"
                style: "filled"
                md_bg_color: COLOR_ACCENT_PRIMARY
                on_release: app.ug_handle_action()
                MDButtonText:
                    text: "Select File" if not app.ug_has_image else ("Analyze" if not app.ug_has_result else "New File")

            MDButton:
                pos_hint: {"center_y": 0.5}
                size_hint_x: 0.3
                height: "44dp"
                style: "filled"
                md_bg_color: COLOR_ACCENT_SECONDARY
                disabled: not app.ug_has_result
                on_release: app.ug_share()
                MDButtonText:
                    text: "Share"

        ScrollView:
            size_hint_y: 0.55
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: "12dp"
                spacing: "6dp"
                size_hint_y: None
                height: self.minimum_height

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "24dp"

                    MDLabel:
                        id: ug_total_label
                        text: "Total: 0"
                        font_style: "Title"
                        halign: "left"

                    MDLabel:
                        id: ug_avg_label
                        text: "Avg Conf: 0.00"
                        font_style: "Title"
                        halign: "right"
                        theme_text_color: "Secondary"

                MDDivider:

                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: "20dp"
                    spacing: "0dp"
                    MDLabel:
                        text: "Type"
                        bold: True
                        size_hint_x: 0.4
                        font_style: "Label"
                    MDLabel:
                        text: "Count"
                        bold: True
                        halign: "center"
                        size_hint_x: 0.3
                        font_style: "Label"
                    MDLabel:
                        text: "Avg Conf"
                        bold: True
                        halign: "center"
                        size_hint_x: 0.3
                        font_style: "Label"

                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: "132dp"
                    spacing: "0dp"
                    MDLabel:
                        text: "PET"
                        font_style: "Body"
                        size_hint_x: 0.4
                    MDLabel:
                        id: ug_pet_count
                        text: "0"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        id: ug_pet_conf
                        text: "0.00"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        text: "HDPE"
                        font_style: "Body"
                        size_hint_x: 0.4
                    MDLabel:
                        id: ug_hdpe_count
                        text: "0"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        id: ug_hdpe_conf
                        text: "0.00"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        text: "PVC"
                        font_style: "Body"
                        size_hint_x: 0.4
                    MDLabel:
                        id: ug_pvc_count
                        text: "0"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        id: ug_pvc_conf
                        text: "0.00"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        text: "LDPE"
                        font_style: "Body"
                        size_hint_x: 0.4
                    MDLabel:
                        id: ug_ldpe_count
                        text: "0"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        id: ug_ldpe_conf
                        text: "0.00"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        text: "PP"
                        font_style: "Body"
                        size_hint_x: 0.4
                    MDLabel:
                        id: ug_pp_count
                        text: "0"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        id: ug_pp_conf
                        text: "0.00"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        text: "PS"
                        font_style: "Body"
                        size_hint_x: 0.4
                    MDLabel:
                        id: ug_ps_count
                        text: "0"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3
                    MDLabel:
                        id: ug_ps_conf
                        text: "0.00"
                        halign: "center"
                        font_style: "Body"
                        size_hint_x: 0.3

                MDDivider:

                MDLabel:
                    id: ug_perf_stats
                    text: ""
                    halign: "center"
                    theme_text_color: "Secondary"
                    font_style: "Label"
                    size_hint_y: None
                    height: "32dp"
